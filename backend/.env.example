# ─── Sahay backend env ───────────────────────────────────────────────
# Copy to .env (not committed) and fill in real values.

# Runtime
ENV=development                                     # development | staging | production
LOG_LEVEL=INFO
PORT=8080

# Database (Neon Postgres)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/sahay

# Cache + rate limiting (Upstash Redis)
REDIS_URL=rediss://default:pass@host:6379

# JWT
JWT_SECRET=change-me-to-32+-bytes-of-random         # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Resend (transactional email — OTP)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Sahay <noreply@mail.sahay.app>
RESEND_REPLY_TO=support@sahay.app

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_DEFAULT=claude-haiku-4-5
CLAUDE_MODEL_QUALITY=claude-sonnet-4-6
CLAUDE_MODEL_INGESTION=claude-opus-4-7

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=sahay-files
R2_PUBLIC_BASE_URL=https://files.sahay.app          # CNAME to R2 bucket

# Replicate (image generation)
REPLICATE_API_TOKEN=r8_...
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# Razorpay (India billing)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Sarvam (STT — used by Android, key here for any backend-side fallback)
SARVAM_API_KEY=...

# Sentry (observability)
SENTRY_DSN=                                          # leave blank to disable

# CORS — comma-separated origins. Use `*` only in dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limits (per-user, per-minute)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=10                                   # OTP requests etc.

# Feature flags
ENABLE_DOCS=true                                     # set false in production
ENABLE_METRICS=true
